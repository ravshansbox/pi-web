{
  "name": "pi-web",
  "version": "0.0.0",
  "description": "Web UI for the pi coding agent",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravshansbox/pi-web.git"
  },
  "homepage": "https://github.com/ravshansbox/pi-web#readme",
  "bugs": {
    "url": "https://github.com/ravshansbox/pi-web/issues"
  },
  "keywords": [
    "pi-package",
    "pi-web",
    "ui"
  ],
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    "dist",
    "build/server",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"tsc -w -p tsconfig.server.json\" \"node --watch build/server/server.js\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:bin": "node scripts/generate-bin.mjs",
    "preview": "vite preview",
    "start": "node build/server/server.js",
    "prepack": "npm run build && npm run build:bin",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
